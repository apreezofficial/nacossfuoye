{
   "$schema": "https://unpkg.com/knip@5/schema.json",
   "next": {
      "entry": [
         "next.config.{js,ts,cjs,mjs}",
         "src/app/**/{page,layout,loading,error,not-found,global-error,route,template,default}.{js,jsx,ts,tsx}",
         "src/middleware.{js,ts}"
      ]
   },
   "project": [
      "src/**/*.{js,jsx,ts,tsx}"
   ],
   "paths": {
      "@/*": [
         "./src/*"
      ]
   }
}